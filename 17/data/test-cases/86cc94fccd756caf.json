ngines entirely.\n\nThat is not a bug to work around, it is the defining property of visual\ntesting: a baseline belongs to one browser on one operating system. Hence\nthe platform- and engine-keyed filename below. In a real project you either\ncommit baselines generated inside the same container CI uses, or you use a\nhosted service that manages exactly this problem for you.\n</code></pre>\n","status":"skipped","statusMessage":"Skipped: No baseline for firefox on linux; recorded one at product-grid.firefox.linux.png. Commit it from the environment CI runs in, then this test starts comparing.","statusTrace":"('/home/runner/work/qa-automation-python/qa-automation-python/tests/web/test_accessibility_and_visual.py', 188, 'Skipped: No baseline for firefox on linux; recorded one at product-grid.firefox.linux.png. Commit it from the environment CI runs in, then this test starts comparing.')","flaky":false,"newFailed":false,"newBroken":false,"newPassed":false,"retriesCount":0,"retriesStatusChange":false,"beforeStages":[{"name":"_session_faker","time":{"start":1786699526949,"stop":1786699526952,"duration":3},"status":"passed","steps":[],"attachments":[],"parameters":[],"stepsCount":0,"shouldDisplayMessage":false,"attachmentsCount":0,"hasContent":false,"attachmentStep":false},{"name":"sut","time":{"start":1786699526953,"stop":1786699526993,"duration":40},"status":"passed","steps":[],"attachments":[],"parameters":[],"stepsCount":0,"shouldDisplayMessage":false,"attachmentsCount":0,"hasContent":false,"attachmentStep":false},{"name":"delete_output_dir","time":{"start":1786699526994,"stop":1786699526994,"duration":0},"status":"passed","steps":[],"attachments":[],"parameters":[],"stepsCount":0,"shouldDisplayMessage":false,"attachmentsCount":0,"hasContent":false,"attachmentStep":false},{"name":"pytestconfig","time":{"start":1786699526994,"stop":1786699526994,"duration":0},"status":"passed","steps":[],"attachments":[],"parameters":[],"stepsCount":0,"shouldDisplayMessage":false,"atta