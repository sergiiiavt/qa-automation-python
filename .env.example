# Copy to .env and adjust. Loaded by pydantic-settings via framework/config.py.
# Precedence: real env vars > .env > defaults in Settings.

QA_ENV=local

# --- services -------------------------------------------------------------
QA_API_BASE_URL=http://127.0.0.1:8000
QA_API_TIMEOUT=10
QA_API_RETRIES=2

# --- web ------------------------------------------------------------------
QA_WEB_BASE_URL=http://127.0.0.1:8000
QA_BROWSER=chromium
QA_HEADLESS=true
QA_SLOW_MO=0

# --- test users -----------------------------------------------------------
QA_USER_NAME=alice
QA_USER_PASSWORD=wonderland

# --- mobile ---------------------------------------------------------------
QA_APPIUM_URL=http://127.0.0.1:4723
QA_PLATFORM=android
QA_DEVICE_NAME=Pixel_7_API_34
QA_PLATFORM_VERSION=14
QA_APP_PATH=./apps/demo.apk
# For mobile-web on a real/emulated device the browser is driven instead of an app:
QA_MOBILE_BROWSER=chrome
