# Copy to .env and adjust. Loaded by pydantic-settings via framework/config.py.
# Precedence: real env vars > .env > defaults in Settings.

QA_ENV=local

# Nested settings groups (api/web/mobile/user) need the "__" delimiter to
# match framework/config.py's env_nested_delimiter — a single "_" is parsed
# as a top-level field name and rejected (extra_forbidden), since Settings
# has no top-level api_base_url/device_name/etc. field.

# --- services -------------------------------------------------------------
QA_API__BASE_URL=http://127.0.0.1:8000
QA_API__TIMEOUT=10
QA_API__RETRIES=2

# --- web ------------------------------------------------------------------
QA_WEB__BASE_URL=http://127.0.0.1:8000
QA_WEB__BROWSER=chromium
QA_WEB__HEADLESS=true
QA_WEB__SLOW_MO=0

# --- test users -----------------------------------------------------------
QA_USER__NAME=alice
QA_USER__PASSWORD=wonderland

# --- mobile ---------------------------------------------------------------
QA_MOBILE__APPIUM_URL=http://127.0.0.1:4723
QA_MOBILE__PLATFORM=android
QA_MOBILE__DEVICE_NAME=Pixel_7_API_34
# Unset by default on purpose: it's a hard filter in Appium's device lookup,
# not a hint, so pinning it here breaks the moment your AVD is a different OS
# version than whatever this file says (which drifts over time as Android
# Studio's recommended system image changes). Only set this for exact-match
# selection across multiple emulators, e.g. a CI device matrix.
# QA_MOBILE__PLATFORM_VERSION=14
# Already defaults to the bundled apps/mda-2.2.0-25.apk (see apps/README.md);
# only set this to point tests/mobile at your own app instead.
# QA_MOBILE__APP_PATH=./apps/your-app.apk
# For mobile-web on a real/emulated device the browser is driven instead of an app:
QA_MOBILE__MOBILE_BROWSER=chrome
