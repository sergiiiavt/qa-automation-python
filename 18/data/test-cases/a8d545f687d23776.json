gines entirely.\n\nThat is not a bug to work around, it is the defining property of visual\ntesting: a baseline belongs to one browser on one operating system. Hence\nthe platform- and engine-keyed filename below. In a real project you either\ncommit baselines generated inside the same container CI uses, or you use a\nhosted service that manages exactly this problem for you.\n</code></pre>\n","status":"skipped","statusMessage":"Skipped: No baseline for webkit on linux; recorded one at product-grid.webkit.linux.png. Commit it from the environment CI runs in, then this test starts comparing.","statusTrace":"('/home/runner/work/qa-automation-python/qa-automation-python/tests/web/test_accessibility_and_visual.py', 188, 'Skipped: No baseline for webkit on linux; recorded one at product-grid.webkit.linux.png. Commit it from the environment CI runs in, then this test starts comparing.')","flaky":false,"newFailed":false,"newBroken":false,"newPassed":false,"retriesCount":0,"retriesStatusChange":false,"beforeStages":[{"name":"_session_faker","time":{"start":1786700857241,"stop":1786700857244,"duration":3},"status":"passed","steps":[],"attachments":[],"parameters":[],"stepsCount":0,"shouldDisplayMessage":false,"attachmentsCount":0,"hasContent":false,"attachmentStep":false},{"name":"sut","time":{"start":1786700857244,"stop":1786700857271,"duration":27},"status":"passed","steps":[],"attachments":[],"parameters":[],"stepsCount":0,"shouldDisplayMessage":false,"attachmentsCount":0,"hasContent":false,"attachmentStep":false},{"name":"base_url","time":{"start":1786700857271,"stop":1786700857272,"duration":1},"status":"passed","steps":[],"attachments":[],"parameters":[],"stepsCount":0,"shouldDisplayMessage":false,"attachmentsCount":0,"hasContent":false,"attachmentStep":false},{"name":"playwright","time":{"start":1786700857272,"stop":1786700857692,"duration":420},"status":"passed","steps":[],"attachments":[],"parameters":[],"stepsCount":0,"shouldDisplayMessage":false,"attachmentsCount":